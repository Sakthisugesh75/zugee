# Copy to .env.local for development. Never commit real values.

# Public site URL (used for metadata, robots.txt and sitemap)
NEXT_PUBLIC_SITE_URL=https://zugee.com

# Supabase - Required for both marketing site AND product application
# SUPABASE_URL: Your Supabase project URL
# SUPABASE_SERVICE_ROLE_KEY: Server-side only (bypasses RLS, for admin operations)
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-side safe key (respects RLS policies)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin portal - required in production.
# ADMIN_PASSWORD: at least 12 characters.
# ADMIN_JWT_SECRET: random, at least 32 characters, different from the password.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating ADMIN_JWT_SECRET signs out every admin session.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# OAuth Token Encryption - REQUIRED for ad integrations
# OAUTH_ENCRYPTION_SECRET: Random secret for encrypting OAuth tokens in database
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   NEVER change this in production - will invalidate all stored tokens
OAUTH_ENCRYPTION_SECRET=

# Meta Ads OAuth - Required for Meta/Facebook Ads integration
# Get these from: https://developers.facebook.com/apps/
# META_APP_ID: Your Facebook App ID
# META_APP_SECRET: Your Facebook App Secret
META_APP_ID=
META_APP_SECRET=

# Google Ads OAuth - Required for Google Ads integration
# Get these from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID
# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret
# GOOGLE_ADS_DEVELOPER_TOKEN: Google Ads API developer token (from Google Ads account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# AI Insights Computation - Required for automated insights generation
# INSIGHTS_COMPUTE_SECRET: Random secret for protecting insights computation endpoint
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Used by cron jobs to authenticate scheduled computations
INSIGHTS_COMPUTE_SECRET=

# Demo Request Email Notifications
# Destination email for demo submissions (default: sugeshwebdevops@gmail.com)
ADMIN_NOTIFICATION_EMAIL=sugeshwebdevops@gmail.com

# Email Sending Method 1: Gmail (Recommended & Quickest)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email Sending Method 2: Custom SMTP / Resend / SendGrid / Brevo
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password
# SMTP_FROM="Zugee Demos" <notifications@zugee.in>