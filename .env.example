# Copy to .env.local for development. Never commit real values.

# Public site URL (used for metadata, robots.txt and sitemap)
NEXT_PUBLIC_SITE_URL=https://www.getzugee.com

# Supabase - Required in production (leads and subscriptions)
# SUPABASE_URL: Your Supabase project URL
# SUPABASE_SERVICE_ROLE_KEY: Server-side only (bypasses RLS, for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal - required in production.
# ADMIN_PASSWORD: at least 12 characters.
# ADMIN_JWT_SECRET: random, at least 32 characters, different from the password.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating ADMIN_JWT_SECRET signs out every admin session.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Demo Request Email Notifications
# Destination email for demo submissions. Use a company mailbox. There is no default: when this is
# blank, the team notification is skipped (a warning is logged) and the lead is only in the admin portal.
ADMIN_NOTIFICATION_EMAIL=

# Email Sending Method 1: SMTP (Zoho Mail in production). Used whenever SMTP_HOST, SMTP_USER and
# SMTP_PASS are all set, even if the Gmail variables below are also set.
# SMTP_HOST: use the Zoho server for your account's region (smtp.zoho.in for India, smtp.zoho.com for US).
# SMTP_USER: the full mailbox address. Emails are sent From this address, and customer replies to
#   the confirmation email come back to it, so it must be a mailbox the team reads.
# SMTP_PASS: the mailbox password, or a Zoho app-specific password when two-factor sign-in is on.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Email Sending Method 2: Gmail (legacy fallback, used only when Method 1 is not fully set)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Search engine ownership verification (optional). Paste only the code from each tool's
# "HTML tag" method, not the whole <meta> tag. Each one is rendered on every page's <head> when set.
# Google Search Console: https://search.google.com/search-console  → google-site-verification
# Bing Webmaster Tools:  https://www.bing.com/webmasters            → msvalidate.01
# Yandex Webmaster:      https://webmaster.yandex.com                → yandex-verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Website chat assistant ("Ask ZUGEE", app/api/chat). Without a key the widget shows the demo and
# WhatsApp buttons and an "unavailable" note instead of answers.
# GEMINI_API_KEY: from https://aistudio.google.com → Get API key. Server-side only.
# GEMINI_MODEL: optional; defaults to gemini-3.5-flash-lite (lib/chatbot/gemini.js).
GEMINI_API_KEY=
GEMINI_MODEL=

# Chat guest limits (10 messages/day per guest, midnight IST reset; lib/chatbot/guest-limits.js).
# Counts are stored in Supabase table chat_guest_usage: run supabase/migrations/0004_chat_guest_usage.sql
# before deploying. Signed-in (admin) users are not limited.
# CHAT_GUEST_SECRET: optional, 32+ random characters, signs the guest cookie and hashes IPs. If unset
#   it is derived from ADMIN_JWT_SECRET. Rotating it gives every guest a fresh daily quota.
# CHAT_GUEST_ALLOW_MEMORY_STORE: local testing only (`next start` without Supabase). Never set it in
#   production: memory counts are per server instance and lost on restart.
CHAT_GUEST_SECRET=
