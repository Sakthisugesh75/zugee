# Copy to .env.local for development. Never commit real values.

# Public site URL (used for metadata, robots.txt and sitemap)
NEXT_PUBLIC_SITE_URL=https://www.getzugee.com

# Supabase - Required in production (leads and subscriptions)
# SUPABASE_URL: Your Supabase project URL
# SUPABASE_SERVICE_ROLE_KEY: Server-side only (bypasses RLS, for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal - required in production.
# ADMIN_PASSWORD: at least 12 characters.
# ADMIN_JWT_SECRET: random, at least 32 characters, different from the password.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating ADMIN_JWT_SECRET signs out every admin session.
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Demo Request Email Notifications
# Destination email for demo submissions. Use a company mailbox. There is no default: when this is
# blank, the team notification is skipped (a warning is logged) and the lead is only in the admin portal.
ADMIN_NOTIFICATION_EMAIL=

# Email Sending Method 1: Gmail (Recommended & Quickest)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email Sending Method 2: Custom SMTP / Resend / SendGrid / Brevo
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password
# SMTP_FROM="Zugee Demos" <notifications@getzugee.com>
